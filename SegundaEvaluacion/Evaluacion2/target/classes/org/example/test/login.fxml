<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Hyperlink?>
<VBox alignment="CENTER" spacing="20.0"
      xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.test.Controllers.loginController"
      prefHeight="600.0" prefWidth="600.0">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Ingresa tus credenciales"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Usuario:"/>

    <TextField fx:id="txtUsuario"
               promptText="Ingrese su usuario"
               prefWidth="300.0"
               maxWidth="300.0"/>

    <Label text="Contraseña:"/>

    <PasswordField fx:id="txtPassword"
                   promptText="Ingrese su contraseña (ENTER para iniciar sesión)"
                   prefWidth="300.0"
                   maxWidth="300.0"/>

    <Button fx:id="btnSesion"
            text="Iniciar Sesión"
            onAction="#iniciarSesion"
            prefWidth="200"/>

    <Label text="¿No tienes una cuenta?"/>

    <Hyperlink fx:id="registrarse"
               text="Registrarse"
               onAction="#abrirRegistro"/>

    <Button text="Salir"
            onAction="#cerrarVentana"/>
</VBox>
