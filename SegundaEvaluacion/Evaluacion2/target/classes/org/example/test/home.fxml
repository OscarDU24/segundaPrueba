<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:id="rootPane"
      fx:controller="org.example.test.Controllers.homeController"
      prefHeight="500.0" prefWidth="700.0">

    <!-- MenuBar: acceso a todas las funciones principales -->
    <MenuBar>
        <menus>
            <Menu text="Archivo">
                <items>
                    <MenuItem text="Registrar Cliente" onAction="#abrirRegistroCliente"/>
                    <MenuItem text="Consultar Clientes" onAction="#abrirConsultas"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Configuración" onAction="#abrirConfig"/>
                    <MenuItem text="Cerrar sesión" onAction="#cerrarSesion"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Salir (ESC)" onAction="#salirAplicacion"/>
                </items>
            </Menu>
            <Menu text="Herramientas">
                <items>
                    <MenuItem text="Elegir carpeta de respaldo..." onAction="#elegirCarpetaRespaldo"/>
                </items>
            </Menu>
            <Menu text="Ayuda">
                <items>
                    <MenuItem text="Acerca de" onAction="#mostrarAcercaDe"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <!-- Barra de sesión: muestra el usuario activo en la esquina superior izquierda -->
    <HBox alignment="CENTER_LEFT">
        <padding>
            <Insets left="10.0" top="6.0" bottom="6.0"/>
        </padding>
        <!-- ContextMenu: clic derecho sobre el label de bienvenida -->
        <Label fx:id="lblUser" text="">
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem text="Actualizar" onAction="#actualizarBienvenida"/>
                        <MenuItem text="Ver información de sesión" onAction="#verInformacionSesion"/>
                        <MenuItem text="Cerrar sesión" onAction="#cerrarSesion"/>
                    </items>
                </ContextMenu>
            </contextMenu>
        </Label>
    </HBox>

    <!-- ToolBar: acceso rápido para cerrar sesión -->
    <ToolBar style="-fx-alignment: CENTER;">
        <items>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </items>
    </ToolBar>

    <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="40.0"/>
        </padding>
        <Label text="Sistema de Registro y Consulta de Solicitudes"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Registrar Cliente" onAction="#abrirRegistroCliente"/>
            <Button text="Consultar Clientes" onAction="#abrirConsultas"/>
        </HBox>
    </VBox>
</VBox>